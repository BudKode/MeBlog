---
import { penNames } from "@/penNames";
import { penUrl } from "@/utils/pen";

const visible = penNames.filter(pen => pen.showOnMainSite);
---

{
  visible.length > 0 && (
    <p class="text-muted-foreground pb-4 text-center text-xs opacity-70">
      Also writing as{" "}
      {visible.map((pen, i) => (
        <>
          {i > 0 && " · "}
          <a href={penUrl(pen.id)} class="hover:text-accent underline decoration-dotted underline-offset-4">
            {pen.name}
          </a>
        </>
      ))}
    </p>
  )
}
