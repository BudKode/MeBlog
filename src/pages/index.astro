---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import ProgressList from "@/components/ProgressList.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import { topics } from "@/topics";
import { getPostsForTopic } from "@/utils/topics";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
const topicSections = topics
  .map(topic => ({
    topic,
    latest: getPostsForTopic(posts, topic).slice(0, 2),
  }))
  .filter(({ latest }) => latest.length > 0);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Hi, I'm Tanner.
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        I'm a data engineer (Python and SQL on Databricks), a hobby CAD designer
        for 3D printing, and an aspiring author. This is where I write about
        all of it.
      </p>
      <p class="mt-2">
        New here? Browse by{" "}
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "topics")}
        >
          topic
        </LinkButton>{" "}
        or read the{" "}
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "about")}
        >
          about page
        </LinkButton>.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <ProgressList owner="main" />

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      topicSections.length > 0 && (
        <section id="topics" class="border-border border-t pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Explore by topic</h2>
          {topicSections.map(({ topic, latest }) => (
            <div class="mt-6">
              <a
                href={getRelativeLocaleUrl(locale, `topics/${topic.slug}/`)}
                class="text-accent text-lg font-medium decoration-dashed underline-offset-4 hover:underline"
              >
                {topic.title} <IconArrowRight class="inline-block size-4" />
              </a>
              <ul>
                {latest.map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </div>
          ))}
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
