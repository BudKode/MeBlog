---
import progress from "@/data/progress.json";

type Item = {
  owner: string;
  title: string;
  kind?: string;
  /** Optional. Leave out when there's no honest number; the status label shows instead. */
  percent?: number;
  /** Short label such as "Revising" or "Prototyping". */
  status?: string;
  note?: string;
  /** Optional link, e.g. the finished model's page. */
  url?: string;
};

type Props = { owner: string; heading?: string };

const { owner, heading = "In progress" } = Astro.props;

const items = (progress as Item[]).filter(item => item.owner === owner);
const clamp = (n: number) => Math.min(100, Math.max(0, Math.round(n)));
---

{
  items.length > 0 && (
    <section class="border-border border-b pt-8 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">{heading}</h2>
      <ul>
        {items.map(item => {
          const pct =
            typeof item.percent === "number" ? clamp(item.percent) : undefined;
          return (
            <li class="my-5">
              <div class="flex items-baseline justify-between gap-4">
                {item.url ? (
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-accent font-medium decoration-dashed underline-offset-4 hover:underline"
                  >
                    {item.title}
                  </a>
                ) : (
                  <span class="font-medium">{item.title}</span>
                )}
                <span class="text-muted-foreground text-sm tabular-nums">
                  {pct !== undefined ? `${pct}%` : item.status}
                </span>
              </div>
              {pct !== undefined && (
                <div
                  class="bg-muted mt-1 h-3 w-full overflow-hidden rounded-full"
                  role="progressbar"
                  aria-label={`${item.title} progress`}
                  aria-valuemin={0}
                  aria-valuemax={100}
                  aria-valuenow={pct}
                >
                  <div
                    class="bg-accent h-full rounded-full"
                    style={`width: ${pct}%`}
                  />
                </div>
              )}
              {item.note && (
                <p class="text-muted-foreground mt-1 text-sm">{item.note}</p>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )
}
