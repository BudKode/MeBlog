---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { topics } from "@/topics";
import { getPostsForTopic } from "@/utils/topics";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts", ({ data }) => !data.draft);

const items = topics.map(topic => ({
  topic,
  count: getPostsForTopic(posts, topic).length,
}));
---

<Layout title={`Topics | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle="Topics" pageDesc="The main things I write about.">
    <ul>
      {
        items.map(({ topic, count }) => (
          <li class="my-6">
            <a
              href={getRelativeLocaleUrl(locale, `topics/${topic.slug}/`)}
              class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline"
            >
              <h2>{topic.title}</h2>
            </a>
            <span class="text-muted-foreground ms-2 text-sm">
              {count} {count === 1 ? "post" : "posts"}
            </span>
            <p>{topic.blurb}</p>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
